---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../../lib/reading-time';
import Icon from '../Icon.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const mins = readingTime(post.body);
const date = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article class="card post" data-reveal data-spotlight>
  <div class="meta mono">
    <time datetime={post.data.pubDate.toISOString()}>{date}</time>
    <span>{mins} min read</span>
  </div>
  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
  <p class="muted">{post.data.description}</p>
  <div class="bottom">
    <ul class="tags">
      {post.data.tags.slice(0, 3).map((t) => <li class="pill">{t}</li>)}
    </ul>
    <a class="more" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>Read <Icon name="arrow" size={14} /></a>
  </div>
</article>

<style>
  .post {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    height: 100%;
  }
  .meta {
    display: flex;
    gap: 1rem;
  }
  .post h3 {
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .post h3 a:hover {
    color: var(--accent);
  }
  .post p {
    flex: 1;
    font-size: 0.98rem;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .more:hover {
    color: var(--accent);
  }
</style>
