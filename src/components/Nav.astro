---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/projects/', label: 'Projects' },
  { href: '/research/', label: 'Research' },
  { href: '/blog/', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="nav-wrap">
  <nav class="nav container" aria-label="Primary">
    <a class="brand" href="/" aria-label={`${profile.name}, home`}>
      <Logo size={34} />
      <span class="brand-name">Sushank Ghimire</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span class="sr-only">Menu</span>
      <Icon name="menu" size={22} class="i-open" />
      <Icon name="close" size={22} class="i-close" />
    </button>
    <div class="nav-menu" id="nav-menu" data-nav-menu>
      <ul class="nav-links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={path !== '/' && l.href.startsWith(path) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn nav-cv" href={profile.cvPath} target="_blank" rel="noopener">
        <Icon name="download" />
        <span>CV</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: rgba(10, 11, 16, 0.72);
    border-bottom: 1px solid rgba(31, 35, 48, 0.7);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-name {
    font-size: 1rem;
  }
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }
  .nav-links a {
    font-size: 0.95rem;
    color: var(--fg-muted);
    transition: color 0.2s var(--ease);
    position: relative;
    padding-block: 0.25rem;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--accent);
    transition: right 0.3s var(--ease);
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--fg);
  }
  .nav-links a:hover::after,
  .nav-links a[aria-current='page']::after {
    right: 0;
  }
  .nav-cv {
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
  }
  .nav-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    color: var(--fg);
  }
  .nav-toggle :global(.i-close) {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] :global(.i-open) {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] :global(.i-close) {
    display: block;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 820px) {
    .brand-name {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
    }
    .nav-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      padding: 1rem var(--gutter) 1.5rem;
      background: rgba(10, 11, 16, 0.96);
      border-bottom: 1px solid var(--line);
      display: none;
    }
    .nav-menu[data-open] {
      display: flex;
    }
    .nav-links {
      flex-direction: column;
      gap: 0.25rem;
    }
    .nav-links a {
      display: block;
      padding: 0.75rem 0;
      font-size: 1.1rem;
      border-bottom: 1px solid var(--line);
    }
    .nav-links a::after {
      display: none;
    }
    .nav-cv {
      justify-content: center;
      margin-top: 0.75rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      if (open) menu.removeAttribute('data-open');
      else menu.setAttribute('data-open', '');
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.removeAttribute('data-open');
      }
    });
  }
</script>
