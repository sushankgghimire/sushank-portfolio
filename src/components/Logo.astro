---
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: cls } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 7)}`;
---

<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#67e8f9"></stop>
      <stop offset="0.55" stop-color="#22d3ee"></stop>
      <stop offset="1" stop-color="#a78bfa"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="16" fill="#0a0b10"></rect>
  <rect x="0.75" y="0.75" width="62.5" height="62.5" rx="15.25" fill="none" stroke="#1f2330" stroke-width="1.5"></rect>
  <path
    d="M47 20.5C46 13.5 39.5 10.5 33 11c-7.5.6-13.5 5.5-12.8 12 .8 7.5 8.8 8.6 15.3 10.6 7 2.2 11 5.4 9.9 11.6-1.2 6.4-8.6 9.3-15.4 8.4-6.5-.8-11.4-4.6-12.6-10"
    fill="none"
    stroke={`url(#${id})`}
    stroke-width="5.2"
    stroke-linecap="round"></path>
  <circle cx="17.4" cy="43.6" r="2.4" fill="#a78bfa"></circle>
  <circle cx="47" cy="20.5" r="2.4" fill="#67e8f9"></circle>
</svg>
