---
import SectionHeading from '../SectionHeading.astro';
import { profile } from '../../data/profile';
---

<section class="section container" id="work" aria-labelledby="work-title">
  <SectionHeading title="Three AI systems in production" id="work-title" text="From the last two years. Client details are private, so I describe the engineering only." />
  <div class="cases">
    {
      profile.caseStudies.map((c) => (
        <article class="case" data-reveal>
          <p class="case-meta">
            <span class="eyebrow">{c.label}</span>
            <span class="mono">{c.employer}</span>
          </p>
          <div class="case-body">
            <div class="case-main">
              <h3>{c.title}</h3>
              <p class="context">{c.context}</p>
              <ul class="built">
                {c.built.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              <p class="stack">{c.stack.join(', ')}</p>
            </div>
            <dl class="outcomes">
              {c.outcomes.map((o) =>
                /\d/.test(o.value) ? (
                  <div class="outcome">
                    <dt>{o.label}</dt>
                    <dd>{o.value}</dd>
                  </div>
                ) : (
                  <div class="outcome outcome-text">
                    <dd>
                      {o.value} {o.label}
                    </dd>
                  </div>
                ),
              )}
            </dl>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .case {
    padding: 2.25rem 0 2.75rem;
    border-top: 1px solid var(--line);
  }
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 1.25rem;
  }
  .case-body {
    display: grid;
    gap: 2rem;
  }
  .case h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-bottom: 0.9rem;
    max-width: 24ch;
  }
  .context {
    color: var(--fg-muted);
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
    max-width: 60ch;
  }
  .built {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    max-width: 64ch;
  }
  .built li {
    position: relative;
    padding-left: 1.2rem;
  }
  .built li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .stack {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  .outcomes {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    align-content: start;
  }
  .outcome {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }
  .outcome dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .outcome dt {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  /* Outcomes without a real number are sentences, not headline stats. */
  .outcome-text dd {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--fg);
  }
  @media (min-width: 960px) {
    .case-body {
      grid-template-columns: 1.7fr 1fr;
      gap: 4rem;
    }
    .outcomes {
      padding-left: 2rem;
      border-left: 1px solid var(--line);
    }
  }
</style>
