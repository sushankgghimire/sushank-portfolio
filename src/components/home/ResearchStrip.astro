---
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import { profile } from '../../data/profile';
---

<section class="section container" id="research" aria-labelledby="research-title">
  <SectionHeading eyebrow="03 · Research" title="Classical ML, done properly, with the paper to prove it" id="research-title" text="Six studies from my engineering degree. Each has a notebook you can run and a write-up you can read.">
    <a class="btn" href="/research/">Read the studies <Icon name="arrow" /></a>
  </SectionHeading>
  <ul class="grid grid-3">
    {
      profile.research.map((s) => (
        <li class="card study" data-reveal data-spotlight>
          <div class="study-top">
            <span class="pill">{s.method}</span>
            <span class="mono">{s.dataset}</span>
          </div>
          <h3>
            <a href={`/research/#${s.slug}`}>{s.title}</a>
          </h3>
          <p class="muted">{s.summary}</p>
          <div class="study-links">
            {s.colab.map((c) => (
              <a href={c.url} target="_blank" rel="noopener" class="slink">
                {c.label} <Icon name="external" size={13} />
              </a>
            ))}
            <a href={encodeURI(s.pdf)} target="_blank" rel="noopener" class="slink">
              Paper (PDF) <Icon name="download" size={13} />
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .study {
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .study-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .study h3 {
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .study h3 a:hover {
    color: var(--accent);
  }
  .study p {
    flex: 1;
    font-size: 0.95rem;
  }
  .study-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .slink {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .slink:hover {
    color: var(--accent);
  }
</style>
