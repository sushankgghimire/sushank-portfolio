---
import SectionHeading from '../SectionHeading.astro';
import { profile } from '../../data/profile';

const groups: { title: string; items: readonly string[] }[] = [
  { title: 'AI and ML', items: profile.skills.ai },
  { title: 'Backend', items: profile.skills.backend },
  { title: 'Languages', items: profile.skills.languages },
  { title: 'Infrastructure', items: profile.skills.infra },
  { title: 'Practices', items: profile.skills.practices },
];
---

<section class="section container" id="skills" aria-labelledby="skills-title">
  <SectionHeading title="Tools I reach for" id="skills-title" text="What I use now. It changes when something better proves itself." />
  <div class="skills">
    {
      groups.map((g) => (
        <div class="group" data-reveal>
          <h3>{g.title}</h3>
          <p>{g.items.join(', ')}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .group {
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }
  .group h3 {
    font-size: 1.1rem;
  }
  .group p {
    max-width: 64ch;
  }
  @media (min-width: 900px) {
    .group {
      grid-template-columns: 14rem 1fr;
      gap: 2rem;
    }
  }
</style>
