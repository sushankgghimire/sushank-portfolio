---
import { Image } from 'astro:assets';
import portrait from '../../assets/sushank-ghimire.png';
import Icon from '../Icon.astro';
import { profile } from '../../data/profile';

const socials = [
  { name: 'github', href: profile.socials.github, label: 'GitHub', handle: profile.handles.github },
  { name: 'linkedin', href: profile.socials.linkedin, label: 'LinkedIn', handle: profile.handles.linkedin },
  { name: 'x', href: profile.socials.x, label: 'X', handle: `@${profile.handles.x}` },
  { name: 'instagram', href: profile.socials.instagram, label: 'Instagram', handle: profile.handles.instagram },
] as const;
---

<section class="section container" id="contact" aria-labelledby="contact-title">
  <div class="contact" data-reveal>
    <div class="contact-copy">
      <h2 id="contact-title">Working on agents, retrieval or document intelligence? Let's talk.</h2>
      <p class="muted">
        I'm an AI engineer in Kathmandu and I work with teams around the world. I answer email within a day, and I'm glad to look at a hard problem before we talk
        about anything else.
      </p>
      <div class="contact-cta">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>
          <Icon name="mail" />
          <span>{profile.email}</span>
        </a>
        <a class="btn" href={profile.cvPath} target="_blank" rel="noopener">
          <Icon name="download" />
          <span>Download CV</span>
        </a>
      </div>
      <ul class="contact-social">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank">
                <Icon name={s.name} size={16} />
                <span>{s.label}</span>
                <span class="mono">{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <figure class="contact-portrait">
      <Image src={portrait} alt="Portrait of Sushank Ghimire, AI engineer in Kathmandu, Nepal" width={320} height={331} loading="lazy" />
      <figcaption class="mono">Kathmandu, UTC+5:45</figcaption>
    </figure>
  </div>
</section>

<style>
  .contact {
    padding: clamp(1.75rem, 4vw, 3.5rem);
    display: grid;
    gap: 2.5rem;
    background: var(--bg-elev-2);
    border-radius: var(--radius);
  }
  .contact h2 {
    font-size: var(--fs-h2);
    margin-bottom: 1rem;
    max-width: 20ch;
  }
  .contact-copy p.muted {
    max-width: 52ch;
    margin-bottom: 1.75rem;
  }
  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }
  .contact-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .contact-social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-size: 0.92rem;
  }
  .contact-social a:hover span:not(.mono) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  .contact-portrait {
    margin: 0;
    justify-self: center;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }
  .contact-portrait img {
    width: min(100%, 240px);
    height: auto;
    aspect-ratio: 491 / 508;
    border-radius: 50%;
    object-fit: cover;
    background: var(--bg-elev);
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 1.5fr 1fr;
      align-items: center;
    }
  }
</style>
