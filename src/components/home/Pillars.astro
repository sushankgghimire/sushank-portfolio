---
import SectionHeading from '../SectionHeading.astro';
import { profile } from '../../data/profile';
---

<section class="section container" id="what" aria-labelledby="pillars-title">
  <SectionHeading title="What I build" id="pillars-title" text="Agents, retrieval, browser automation and the backends behind them. All of it runs in production." />
  <ol class="pillars">
    {
      profile.pillars.map((p) => (
        <li class="pillar" data-reveal>
          <span class="n">{p.n}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <p class="tags">{p.tags.join(', ')}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .pillars {
    display: grid;
    gap: 0 3rem;
  }
  .pillar {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.75rem 0 2rem;
    border-top: 1px solid var(--line);
  }
  .n {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--accent);
  }
  .pillar h3 {
    font-size: var(--fs-h3);
  }
  .tags {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  @media (min-width: 760px) {
    .pillars {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
