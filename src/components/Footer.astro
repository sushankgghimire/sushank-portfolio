---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const year = new Date().getFullYear();
const socials = [
  { name: 'github', href: profile.socials.github, label: 'GitHub' },
  { name: 'linkedin', href: profile.socials.linkedin, label: 'LinkedIn' },
  { name: 'x', href: profile.socials.x, label: 'X' },
  { name: 'instagram', href: profile.socials.instagram, label: 'Instagram' },
] as const;
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo size={40} />
      <div>
        <p class="footer-name">Sushank Ghimire</p>
        <p class="muted">AI Engineer in Kathmandu, Nepal. Building LLM agents, RAG systems and the backends behind them.</p>
      </div>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <ul>
        <li><a href="/#work">Work</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/research/">Research</a></li>
        <li><a href="/blog/">Writing</a></li>
        <li><a href={profile.cvPath} target="_blank" rel="noopener">CV</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <ul class="footer-social" aria-label="Social profiles">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank" aria-label={`${profile.name} on ${s.label}`}>
              <Icon name={s.name} size={18} />
            </a>
          </li>
        ))
      }
      <li>
        <a href={`mailto:${profile.email}`} aria-label={`Email ${profile.name}`}>
          <Icon name="mail" size={18} />
        </a>
      </li>
    </ul>
  </div>
  <div class="container footer-bottom">
    <span class="mono">&copy; {year} Sushank Ghimire</span>
    <span class="mono">sushankghimire.com.np</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(17, 19, 26, 0.7));
    padding-top: 3.5rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
  }
  .footer-brand {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    max-width: 34rem;
  }
  .footer-name {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .footer-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .footer-links a {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .footer-links a:hover {
    color: var(--fg);
  }
  .footer-social {
    display: flex;
    gap: 0.5rem;
  }
  .footer-social a {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--fg-muted);
    transition: color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .footer-social a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr auto;
      align-items: start;
    }
  }
</style>
