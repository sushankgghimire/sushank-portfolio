---
// Static constellation shown before (or instead of) the WebGL field.
const seed = 7;
let s = seed;
const rnd = () => {
  s = (s * 16807) % 2147483647;
  return s / 2147483647;
};
const pts = Array.from({ length: 70 }, () => ({ x: 20 + rnd() * 360, y: 20 + rnd() * 360, r: 0.8 + rnd() * 1.6 }));
const lines: { a: (typeof pts)[number]; b: (typeof pts)[number] }[] = [];
for (let i = 0; i < pts.length; i++) {
  for (let j = i + 1; j < pts.length; j++) {
    const d = Math.hypot(pts[i].x - pts[j].x, pts[i].y - pts[j].y);
    if (d < 46) lines.push({ a: pts[i], b: pts[j] });
  }
}
---

<svg class="fallback" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="hf-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#22d3ee" stop-opacity="0.22"></stop>
      <stop offset="1" stop-color="#22d3ee" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <circle cx="200" cy="200" r="190" fill="url(#hf-glow)"></circle>
  {lines.map((l) => <line x1={l.a.x} y1={l.a.y} x2={l.b.x} y2={l.b.y} stroke="#22d3ee" stroke-opacity="0.18" stroke-width="0.6" />)}
  {pts.map((p) => <circle cx={p.x} cy={p.y} r={p.r} fill="#67e8f9" fill-opacity="0.8" />)}
</svg>

<style>
  .fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
