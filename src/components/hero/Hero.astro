---
import { Image } from 'astro:assets';
import portrait from '../../assets/sushank-hero.jpg';
import Icon from '../Icon.astro';
import { profile } from '../../data/profile';

const socials = [
  { name: 'github', href: profile.socials.github, label: 'GitHub' },
  { name: 'linkedin', href: profile.socials.linkedin, label: 'LinkedIn' },
  { name: 'x', href: profile.socials.x, label: 'X' },
] as const;
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">AI engineer in Kathmandu, Nepal</p>
    <h1 id="hero-title" class="hero-title">Sushank Ghimire</h1>
    <p class="hero-lede">
      I build <strong>LLM agents</strong> that call tools and drive browsers, <strong>retrieval systems</strong> that survive messy documents, and the{' '}
      <strong>FastAPI backends</strong> that keep them at 99.9% uptime.
    </p>
    <p class="hero-now">Right now: {profile.currentEmployer.role} at {profile.currentEmployer.name}.</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="#work">
        <span>See the work</span>
        <Icon name="arrow" />
      </a>
      <a class="btn" href="/blog/">
        <span>Read the writing</span>
      </a>
      <ul class="hero-social" aria-label="Profiles">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" aria-label={`${profile.name} on ${s.label}`}>
                <Icon name={s.name} size={20} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <figure class="hero-photo">
    <Image src={portrait} alt="Sushank Ghimire smiling in sunglasses and a red checked shirt" width={540} height={675} widths={[270, 540]} sizes="(min-width: 300px) 270px, 100vw" loading="eager" fetchpriority="high" />
  </figure>
</section>

<style>
  .hero {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hero-title {
    font-size: var(--fs-hero);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .hero-lede {
    font-size: clamp(1.1rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    max-width: 34rem;
  }
  .hero-lede strong {
    font-weight: 700;
    color: var(--ink);
  }
  .hero-now {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .hero-social {
    display: flex;
    gap: 0.25rem;
    margin-left: -0.6rem;
  }
  @media (min-width: 640px) {
    .hero-social {
      margin-left: 0.25rem;
    }
  }
  .hero-social a {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    transition: color 0.2s;
  }
  .hero-social a:hover {
    color: var(--accent);
  }
  .hero-photo {
    margin: 0 auto;
    width: min(100%, 270px);
  }
  /* The photo dissolves into the paper: soft oval edge, multiplied onto the page colour, slightly transparent. */
  .hero-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 45% 30%;
    mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(ellipse 52% 54% at 50% 44%, #000 72%, transparent 100%);
    mask-image: radial-gradient(ellipse 52% 54% at 50% 44%, #000 72%, transparent 100%);
    animation: photo-in 0.5s ease-out 0.05s both;
  }
  @keyframes photo-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.85;
    }
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 4rem;
    }
    .hero-photo {
      margin: 0 0 0 auto;
    }
  }
</style>
