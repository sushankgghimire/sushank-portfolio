---
type Step = { role: 'user' | 'plan' | 'tool' | 'obs' | 'reflect' | 'final'; text: string; meta?: string };
const steps: Step[] = [
  { role: 'user', text: 'Pull the deductible and effective date from this 41 page policy PDF.', meta: 'request' },
  { role: 'plan', text: 'Document is scanned. Run OCR, locate the declarations page, then extract typed fields.', meta: '312 ms' },
  { role: 'tool', text: 'ocr_document(pages="all", engine="layout")', meta: 'tool_call' },
  { role: 'obs', text: '41 pages, 2 tables detected, declarations page = 3', meta: '2.4 s' },
  { role: 'tool', text: 'extract_fields(page=3, schema=PolicyDeclarations)', meta: 'tool_call' },
  { role: 'obs', text: '{ deductible: "$2,500", effective_date: "2026-03-01", confidence: 0.97 }', meta: '840 ms' },
  { role: 'reflect', text: 'Deductible matches the premium table on page 7. No schema mismatch. Done.', meta: '1 pass' },
  { role: 'final', text: 'Deductible $2,500, effective 1 March 2026. Source: page 3, verified against page 7.', meta: '1,912 tokens' },
];
const label: Record<Step['role'], string> = {
  user: 'user',
  plan: 'plan',
  tool: 'tool_call',
  obs: 'observation',
  reflect: 'reflect',
  final: 'final',
};
---

<section class="trace-wrap container" aria-label="An agent calling tools">
  <div class="trace" data-agent-trace>
    <ol class="trace-lines">
      {
        steps.map((s) => (
          <li class={`line role-${s.role}`} data-trace-line>
            <span class="role">{label[s.role]}</span>
            <span class="text" data-trace-text>
              {s.text}
            </span>
            {s.meta && <span class="meta">{s.meta}</span>}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .trace-wrap {
    padding-block: 0 var(--section-gap);
  }
  /* A quiet example, not a feature. Light card, small type, capped width. */
  .trace {
    max-width: 50rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow: hidden;
  }
  .trace-lines {
    padding: 0.4rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .line {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    gap: 0.25rem 1rem;
    padding: 0.25rem 1rem;
    align-items: baseline;
  }
  .line[data-hidden] {
    visibility: hidden;
  }
  .role,
  .meta {
    font-size: 0.72rem;
    color: var(--fg-dim);
  }
  .text {
    color: var(--fg);
    word-break: break-word;
  }
  .role-plan .text,
  .role-reflect .text {
    color: var(--fg-muted);
  }
  .role-tool .role,
  .role-tool .text {
    color: var(--accent);
  }
  .role-obs .text {
    color: var(--ink);
  }
  .role-final .text {
    color: var(--ink);
    font-weight: 600;
  }
  .text[data-typing]::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 2px;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 0.9s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 640px) {
    .line {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
    .meta {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-agent-trace]');
  if (root && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const start = () => setTimeout(() => import('../scripts/agent-trace').then((m) => m.mount(root)).catch(() => {}), 800);
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>
