---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { graph, person, website, breadcrumbs, scholarlyArticles } from '../lib/jsonld';

const title = 'Machine learning research and papers by Sushank Ghimire';
const description =
  'Six machine learning studies by Sushank Ghimire: PCA, decision trees, Naive Bayes, KNN, neural networks and KD-trees, each with a runnable notebook and a written paper.';
const jsonld = graph(person(), website(), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Research', path: '/research/' }]), ...scholarlyArticles());
---

<Base title={title} description={description} jsonld={jsonld}>
  <section class="page container">
    <nav class="crumbs mono" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Research</span></nav>
    <header class="page-head" data-reveal>
      <p class="eyebrow">Research</p>
      <h1>Classical machine learning, studied properly</h1>
      <p class="muted lede">
        These six studies come from my computer engineering degree at Thapathali Campus. Each one takes a single algorithm, runs it on real datasets, and writes up what
        worked and what did not. They are small, but they are honest, and they are where I learned to measure before I believe.
      </p>
    </header>
    <ol class="studies">
      {
        profile.research.map((s, i) => (
          <li class="study card" id={s.slug} data-reveal data-spotlight>
            <div class="study-meta">
              <span class="mono idx">0{i + 1}</span>
              <span class="pill">{s.method}</span>
              <span class="mono">{s.dataset}</span>
            </div>
            <div class="study-body">
              <h2>{s.title}</h2>
              <p class="muted">{s.summary}</p>
              <div class="study-links">
                {s.colab.map((c) => (
                  <a class="btn" href={c.url} target="_blank" rel="noopener">
                    {c.label} <Icon name="external" />
                  </a>
                ))}
                <a class="btn btn-primary" href={encodeURI(s.pdf)} target="_blank" rel="noopener">
                  Read the paper <Icon name="download" />
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .page {
    padding-block: 3rem var(--section-gap);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .page-head {
    margin-bottom: 3rem;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0.75rem 0 1rem;
    max-width: 22ch;
  }
  .lede {
    max-width: 62ch;
    font-size: 1.1rem;
  }
  .studies {
    display: grid;
    gap: 1.25rem;
  }
  .study {
    padding: 1.75rem;
    display: grid;
    gap: 1.25rem;
    scroll-margin-top: 6rem;
  }
  .study-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .idx {
    color: var(--accent);
  }
  .study h2 {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    margin-bottom: 0.6rem;
  }
  .study-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 900px) {
    .study {
      grid-template-columns: 14rem 1fr;
    }
    .study-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
