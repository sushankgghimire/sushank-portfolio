---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { graph, person, website, breadcrumbs } from '../../lib/jsonld';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const ai = all.filter((p) => p.data.category === 'ai');
const web = all.filter((p) => p.data.category === 'web');
const title = 'Projects by Sushank Ghimire: AI, machine learning and backend work';
const description =
  'Open source and side projects by Sushank Ghimire, from a transformer-based crossword solver and YOLO license plate detection to async FastAPI services and Django platforms.';
---

<Base title={title} description={description} jsonld={graph(person(), website(), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Projects', path: '/projects/' }]))}>
  <section class="page container">
    <nav class="crumbs mono" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Projects</span></nav>
    <header class="page-head" data-reveal>
      <p class="eyebrow">Projects</p>
      <h1>Things I have built and shipped</h1>
      <p class="muted lede">AI and machine learning first, then the web platforms and backends that taught me how to run software for real users.</p>
    </header>
    <h2 class="group-title"><span class="eyebrow">AI and machine learning</span></h2>
    <div class="grid grid-3">
      {ai.map((p, i) => <ProjectCard project={p} large={i === 0} />)}
    </div>
    <h2 class="group-title"><span class="eyebrow">Web and backend</span></h2>
    <div class="grid grid-3">
      {web.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<style>
  .page {
    padding-block: 3rem var(--section-gap);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .page-head {
    margin-bottom: 3rem;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0.75rem 0 1rem;
  }
  .lede {
    max-width: 60ch;
    font-size: 1.1rem;
  }
  .group-title {
    margin: 3rem 0 1.25rem;
  }
  .group-title:first-of-type {
    margin-top: 0;
  }
</style>
