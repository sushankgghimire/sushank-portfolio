---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { graph, person, website, breadcrumbs } from '../../../lib/jsonld';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) },
  }));
}

const { tag, posts } = Astro.props;
const title = `Posts tagged ${tag} | Sushank Ghimire`;
const description = `Writing by Sushank Ghimire on ${tag}: ${posts.length} ${posts.length === 1 ? 'post' : 'posts'} about building AI systems that hold up in production.`;
---

<Base
  title={title}
  description={description}
  jsonld={graph(
    person(),
    website(),
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Writing', path: '/blog/' },
      { name: `#${tag}`, path: `/blog/tags/${tag}/` },
    ]),
  )}
>
  <section class="page container">
    <nav class="crumbs mono" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog/">Writing</a><span>/</span><span aria-current="page">#{tag}</span></nav>
    <header class="page-head" data-reveal>
      <p class="eyebrow">Tag</p>
      <h1>#{tag}</h1>
      <p class="muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </header>
    <div class="grid grid-2">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </section>
</Base>

<style>
  .page {
    padding-block: 3rem var(--section-gap);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .page-head {
    margin-bottom: 2.5rem;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0.75rem 0 0.5rem;
  }
</style>
