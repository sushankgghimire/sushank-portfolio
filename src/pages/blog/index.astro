---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/blog/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { graph, person, website, breadcrumbs, blogIndex } from '../../lib/jsonld';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const title = 'Writing on AI engineering by Sushank Ghimire';
const description =
  'Essays and field notes by Sushank Ghimire on building LLM agents, retrieval-augmented generation, document extraction and the FastAPI backends that hold them together.';
---

<Base title={title} description={description} jsonld={graph(person(), website(), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Writing', path: '/blog/' }]), blogIndex(posts))}>
  <section class="page container">
    <nav class="crumbs mono" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Writing</span></nav>
    <header class="page-head" data-reveal>
      <p class="eyebrow">Writing</p>
      <h1>Notes from building agents and retrieval systems</h1>
      <p class="muted lede">
        What broke in production, what fixed it, and the patterns I keep coming back to. Written by Sushank Ghimire, mostly late at night, always after the incident is
        closed.
      </p>
      <div class="tools">
        <ul class="tags">
          {tags.map((t) => <li><a class="pill" href={`/blog/tags/${t}/`}>#{t}</a></li>)}
        </ul>
        <a class="btn" href="/rss.xml"><Icon name="rss" /> RSS</a>
      </div>
    </header>
    <div class="grid grid-2">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </section>
</Base>

<style>
  .page {
    padding-block: 3rem var(--section-gap);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .page-head {
    margin-bottom: 3rem;
  }
  .page-head h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0.75rem 0 1rem;
    max-width: 22ch;
  }
  .lede {
    max-width: 62ch;
    font-size: 1.1rem;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
