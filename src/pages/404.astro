---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found | Sushank Ghimire" description="That page does not exist on Sushank Ghimire's site. Head back to the work, the projects or the writing." noindex>
  <section class="nf container">
    <p class="eyebrow">404 · tool_call(find_page) returned null</p>
    <h1>Nothing lives at this address.</h1>
    <p class="muted">The agent searched the whole site and came back empty. Try one of these instead.</p>
    <div class="links">
      <a class="btn btn-primary" href="/">Home <Icon name="arrow" /></a>
      <a class="btn" href="/projects/">Projects</a>
      <a class="btn" href="/blog/">Writing</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 60dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding-block: 6rem;
  }
  .nf h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
